{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src-tauri/target/release/bundle/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "check": {
      "dependsOn": ["^check"]
    },
    "lint": {}
  }
}
