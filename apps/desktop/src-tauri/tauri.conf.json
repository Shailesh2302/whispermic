{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhisperMic",
  "version": "0.1.0",
  "identifier": "com.whispermic.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "WhisperMic",
        "url": "index.html",
        "width": 380,
        "height": 170,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focusable": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Tiny real-time dictation at your cursor",
    "longDescription": "Speak anywhere. Refined text streams where your cursor is. Rust engine, <300ms latency.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
